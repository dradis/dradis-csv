<% content_for :title, 'CSV Upload' %>

<% content_for :breadcrumbs do %>
  <nav>
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <%= link_to 'Upload Manager', main_app.project_upload_manager_path(current_project) %>
      </li>
      <li class="breadcrumb-item active">CSV Upload</li>
    </ol>
  </nav>
<% end %>

<div class="content-container">
  <div class="alert alert-info">
    <p class="mb-0">
      A saved mapping for this CSV format was found and is being applied
      automatically. You can review or update it from the Mappings Manager.
    </p>
  </div>

  <h4 class="header-underline">Output console</h4>
  <div id="status"></div>
  <%= content_tag :div, id: 'result', data: { url: main_app.status_console_index_path, behavior: 'csv-auto-import', log_uid: @log_uid } do %>
    <div id="console" class="mx-0 mb-0"></div>
  <% end %>
</div>
